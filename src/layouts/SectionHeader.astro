---
import Cursor from "./Cursor.astro";

interface Props {
  icon: string;
  title: string;
  subTitle: string;
}

const { icon, title, subTitle } = Astro.props;
---

<div>
  <p class="tag">{subTitle}</p>
  <div class="section_header">
    <span>{icon}</span>
    <h1>{title}<Cursor width="20px" height="3px" /></h1>
  </div>
</div>

<style lang="scss">
  .section_header {
    display: flex;
    gap: 8px;
    align-items: center;

    span {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      color: black;
      background-color: white;
      width: 36px;
      height: 36px;
      flex-shrink: 0;
    }

    h1 {
      margin: 0;
    }
  }
</style>
